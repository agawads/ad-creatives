{%- comment -%}
  EasySell UTM cleaner (Pshift, 2026-11-08).
  Meta url_tags put campaign names (spaces, |, ') into utm_campaign. EasySell stores orders with the raw
  encoded value but files form opens differently, so the UTM table shows orders with 0 opens.
  This wraps EasySellHelpers.getUtms (used for both the open event and the order) so campaign/source/medium
  become plain ASCII ("A.G | Lifetime value | Batch 3" -> "A.G-Lifetime-value-Batch-3").
  Non-Latin names fall back to utm_id (campaign id). URL, Shopify analytics and pixels are untouched.
  Rollback: delete the render line in layout/theme.liquid.
{%- endcomment -%}
<script>
(function () {
  try {
    var SAFE = /^[A-Za-z0-9._-]*$/;
    function clean(v, fallback) {
      if (v == null) return v;
      var s = String(v);
      if (SAFE.test(s)) return s;
      var d = s.replace(/\+/g, ' ');
      try { d = decodeURIComponent(d); } catch (e) {}
      var out = d.replace(/[^A-Za-z0-9.]+/g, '-').replace(/^-+|-+$/g, '');
      if (out.replace(/[^A-Za-z0-9]/g, '').length < 3) return fallback || out || s;
      return out;
    }
    function wrap(h) {
      if (!h || typeof h.getUtms !== 'function' || h.getUtms.fzlClean) return;
      var orig = h.getUtms;
      var wrapped = function () {
        var r = orig.apply(this, arguments);
        try {
          if (r && typeof r === 'object') {
            var id = r.utm_id && /^[0-9]+$/.test(String(r.utm_id)) ? String(r.utm_id) : null;
            if (r.utm_campaign) r.utm_campaign = clean(r.utm_campaign, id);
            if (r.utm_source) r.utm_source = clean(r.utm_source, null);
            if (r.utm_medium) r.utm_medium = clean(r.utm_medium, null);
          }
        } catch (e) {}
        return r;
      };
      wrapped.fzlClean = true;
      h.getUtms = wrapped;
    }
    var store = window.EasySellHelpers;
    if (store) wrap(store);
    Object.defineProperty(window, 'EasySellHelpers', {
      configurable: true,
      enumerable: true,
      get: function () { return store; },
      set: function (v) { store = v; wrap(v); }
    });
  } catch (e) {}
})();
</script>
