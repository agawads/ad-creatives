{%- comment -%} Black Friday badge above the hero price on FZL landers. Auto-hides after 2026-11-30 23:59 Cairo. Remove the render in layout/theme.liquid to roll back. {%- endcomment -%}
{%- assign fzl_bf_now = 'now' | date: '%s' | plus: 0 -%}
{%- if fzl_bf_now < 1796075999 -%}
<style>.fzl-bf{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:0 0 8px}.fzl-bf-tag{background:#111;color:#fff;font:800 12px/1 system-ui,sans-serif!important;letter-spacing:.06em;padding:6px 9px;border-radius:6px;direction:ltr}.fzl-bf-tag i{font-style:normal;color:#ffcf33}.fzl-bf-c{white-space:nowrap;direction:rtl;unicode-bidi:isolate}.fzl-bf-t{font-size:12.5px;font-weight:700;color:#b3125f;font-variant-numeric:tabular-nums}</style>
<script>(function(){var end=1796075999000;if(Date.now()>=end)return;var pr=document.querySelector('.fzl-pricebox .fzl-price');if(!pr||document.querySelector('.fzl-bf'))return;var el=document.createElement('div');el.className='fzl-bf';el.innerHTML='<span class="fzl-bf-tag">BLACK <i>FRIDAY</i></span><span class="fzl-bf-t">العرض ينتهي خلال <b class="fzl-bf-c"></b></span>';pr.parentNode.insertBefore(el,pr);var c=el.querySelector('.fzl-bf-c');function p(n){return n<10?'0'+n:''+n}function t(){var d=end-Date.now();if(d<=0){el.remove();clearInterval(iv);return}var D=Math.floor(d/864e5),H=Math.floor(d%864e5/36e5),M=Math.floor(d%36e5/6e4),S=Math.floor(d%6e4/1e3);c.textContent=(D?D+' يوم ':'')+p(H)+':'+p(M)+':'+p(S)}var iv=setInterval(t,1000);t()})();</script>
{%- endif -%}
