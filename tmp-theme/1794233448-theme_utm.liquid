{%- unless template.suffix == 'a-configs' and request.design_mode == false -%}

<!doctype html>
{%- liquid
  assign t_name     = request.page_type
  assign iso_code   = request.locale.iso_code
  assign use_rtl    = settings.use_rtl
  if use_rtl == '3'
    assign lis_rtl  = 'ar; dv; ha; he; ku; fa; ur; ug; ps; yi'
    assign iso_code_ck = iso_code | split: '-' | first
  else 
    assign lis_rtl = settings.list_rtl
    assign iso_code_ck = iso_code
  endif
  if use_rtl == '1'
    assign isRTL = true
  elsif lis_rtl contains iso_code_ck and use_rtl == '2' or use_rtl == '3'
    assign isRTL = true
  else
    assign isRTL = false
  endif
  assign body_img = settings.body_bg_image
  if body_img != blank and settings.general_layout == 'boxed'
    assign class_lazy = 'lazyloadt4s'
  endif -%}
{%- capture class_html -%}
t4sp-theme t4s-wrapper__{{ settings.general_layout }}{% if settings.animations_reveal_on_scroll %} hdt-reveal-in-view{% endif %} rtl_{{ isRTL }} swatch_color_style_{{ settings.swatch_color_style }} pr_border_style_{{ settings.pr_border_style }} pr_img_effect_{{ settings.pr_img_effect }} enable_eff_img1_{{ settings.enable_eff_img1 }} badge_shape_{{ settings.badge_shape }} css_for_wis_app_{{ settings.enable_css_wis }}{% if settings.use_cus_lz and settings.cus_lz %} t4s-lzcus-true{% endif %} shadow_round_img_{{ settings.enable_shadow_round_img }} t4s-header__{{ settings.header_design }} is-remove-unavai-{{ settings.variant_remove }} t4_compare_{{ settings.enable_compe }}{% if settings.type_qv == '1' %} t4s-sidebar-qv{% endif %} t4s-cart-count-{{ cart.item_count }} t4s-pr-ellipsis-{{ settings.enable_pr_ellipsis }}
{%- endcapture -%}
<html class="{{ class_html }} no-js" lang="{{ iso_code }}"{% if isRTL %} dir="rtl"{% endif %}>
  <head>
    <meta charset="utf-8">
    {%- render 'fzl-utm-clean' -%}
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, height=device-height, minimum-scale=1.0, maximum-scale=1.0">
    <meta name="theme-color" content="{{ settings.body_bg }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    
    {%- if settings.favicon != blank %}<link rel="shortcut icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">{% endif -%}
    {%- if settings.favicon_apple != blank %}<link rel="apple-touch-icon-precomposed" type="image/png" sizes="152x152" href="{{ settings.favicon_apple | image_url: width: 152 }}">{% endif -%}

    {%- if settings.font_source == '1' and settings.fnt_fm_sp1.system? == false or settings.fnt_fm_sp2.system? == false or settings.fnt_fm_sp3.system? == false -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endif -%}
    
    {%- if t_name != 'list-collections' -%}
    {%- capture seo_title -%}
      {%- if template == 'search' and search.performed == true -%}{{ 'search.general.heading' | t: count: search.results_count }}: {{ 'search.results_with_count_and_term' | t: terms: search.terms, count: search.results_count }}{%- elsif template == 'search.wishlist' %}{{ 'wishlist_page.meta' | t }}{%- elsif template == 'search.compare' %}{{ 'compare_page.meta' | t }}{%- else -%}{{ page_title }}{%- endif -%}
      {%- if current_tags -%}{%- assign meta_tags = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags -}}{%- endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{%- endif -%}
      {%- assign escaped_page_title = page_title | escape -%}
      {%- unless escaped_page_title contains shop.name %} &ndash; {{ shop.name }}{%- endunless -%}
    {%- endcapture -%}
    <title>{{ seo_title | strip }}</title>
    <meta name="description" content="{{ page_description | default: shop.description | default: shop.name | escape }}">
    {%- else -%}
    <title>{{ 'list_collections.meta_title' | t | escape }}</title><meta name="description" content="{{ 'list_collections.meta_description' | t | escape }}">
    {%- endif -%}

    {%- render 'meta-tags', t_name: t_name -%}
    
    <script src="{{ 'lazysizes.min.js' | asset_url }}" async="async"></script>
    <script src="{{ 'global.min.js' | asset_url }}" defer="defer"></script>
    {{ content_for_header }}
    {%- render 'head_assets', t_name: t_name, isRTL: isRTL -%}
    
    {%- if iso_code == 'ar' -%}
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
      <style>
        body, h1, h2, h3, h4, h5, h6, p, a, span, div, button, input, select, textarea {
          font-family: 'Cairo', sans-serif !important;
        }
        p, li, .t4s-rte, .t4s-text-bl {
          line-height: 1.8 !important;
        }
        h1, h2, h3, h4, h5, h6 {
          line-height: 1.5 !important;
        }
      </style>
    {%- endif -%}
   <script>
  
  </head>

  <body class="template-{{ request.page_type | handle }} {{ class_lazy }}"{% if body_img != blank %} data-bgset="{{ body_img | image_url: width: 1 }}" data-optimumx="2" data-sizes="auto"{% endif -%}>{% if isRTL %}<script type="text/javascript" id="t4s-flicker-fix">// Flicker fix.</script>{% endif -%}
    <a class="skip-to-content-link visually-hidden" href="#MainContent">{{ "accessibility.skip_to_text" | t }}</a>
    <div class="t4s-close-overlay t4s-op-0"></div>

    <div class="t4s-website-wrapper">
      {%- render 'header', t_name: t_name -%}

      <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
        {{ content_for_layout }}
      </main>

      <footer id="t4s-footer">
        {%- section 'footer' -%}
        {%- section 'bottom-bar' -%}
      </footer>
    </div>

      <ul hidden class="t4s-d-none">
        <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      </ul>
    {%- liquid
      render 'render_bottom'
      render 'structured-data'
    -%}
    
      <script>
document.addEventListener("DOMContentLoaded", function() {
  document.querySelectorAll('[data-sortby-item]').forEach(function(el) {
    if (el.textContent.trim() === "Most relevant") {
      el.textContent = "الأكثر صلة";
    }
  });
});
</script>
<style>
#es-whatsapp-popup-overlay{
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.45);
    display:none;
    align-items:center;
    justify-content:center;
    z-index:999999;
    padding:20px;
}

#es-whatsapp-popup{
    width:100%;
    max-width:420px;
    background:#fff;
    border-radius:18px;
    padding:28px 24px;
    text-align:center;
    box-shadow:0 20px 60px rgba(0,0,0,.25);
    animation:popupIn .25s ease;
    font-family:"Cairo",sans-serif;
}

#es-whatsapp-popup h3{
    margin:0 0 12px;
    font-size:24px;
    line-height:1.4;
}

#es-whatsapp-popup p{
    margin:0 0 24px;
    color:#666;
    line-height:1.8;
    font-size:15px;
}

#es-whatsapp-popup .buttons{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
}

#es-whatsapp-popup button{
    flex:1;
    height:48px;
    border:none;
    border-radius:10px;
    font-family:"Cairo",sans-serif;
    font-size:15px;
    font-weight:700;
    cursor:pointer;
    transition:.2s;
}

#es-wa-btn{
    background:#25D366;
    color:#fff;
}

#es-wa-btn:hover{
    background:#1ebe5d;
}

#es-close-btn{
    background:#000;
    color:#fff;
}

#es-close-btn:hover{
    opacity:.9;
}

@keyframes popupIn{
    from{
        transform:translateY(15px) scale(.95);
        opacity:0;
    }
    to{
        transform:none;
        opacity:1;
    }
}

@media(max-width:480px){

    #es-whatsapp-popup{
        padding:22px 18px;
    }

    #es-whatsapp-popup h3{
        font-size:20px;
    }

    #es-whatsapp-popup p{
        font-size:14px;
    }

    #es-whatsapp-popup .buttons{
        flex-direction:column;
    }
}
</style>

<div id="es-whatsapp-popup-overlay">
    <div id="es-whatsapp-popup">
        <h3></h3>
        <p></p>

        <div class="buttons">
            <button id="es-wa-btn"></button>
            <button id="es-close-btn"></button>
        </div>
    </div>
</div>
<script>
(function () {

const phone = "201007960319";

const overlay = document.getElementById("es-whatsapp-popup-overlay");
const popup = document.getElementById("es-whatsapp-popup");

if (!overlay || !popup) return;

const isArabic =
document.documentElement.lang.startsWith("ar") ||
(window.Shopify && Shopify.locale === "ar");

const t = isArabic ? {
title:"💬 عندك استفسار؟",
text:"لو بتواجه أي مشكلة في اتمام الطلب تواصل معانا على الواتساب وهنساعدك",
whatsapp:"تواصل عبر واتساب",
message:"مرحبًا 👋\n\nلدي استفسار بخصوص المنتجات التالية:\n\n",
qty:"الكمية",
price:"السعر",
total:"الإجمالي",
store:"رابط المتجر"
} : {
title:"💬 Need any help?",
text:"If you have any questions or need assistance with your order, our team is happy to help you on WhatsApp.",
whatsapp:"Chat on WhatsApp",
message:"Hi 👋\n\nI have a question about the following products:\n\n",
qty:"Qty",
price:"Price",
total:"Total",
store:"Store URL"
};

/* -------------------------
   Remove old close button
------------------------- */

const oldClose = document.getElementById("es-close-btn");
if(oldClose) oldClose.remove();

/* -------------------------
   Add top close icon
------------------------- */

const closeIcon=document.createElement("button");
closeIcon.innerHTML="&times;";
closeIcon.type="button";

closeIcon.style.cssText=`
position:absolute;
top:12px;
${isArabic ? "left:12px;" : "right:12px;"}
width:32px;
height:32px;
background:none;
border:none;
font-size:28px;
cursor:pointer;
color:#777;
line-height:1;
padding:0;
z-index:9999999999999;
`;

popup.style.position="relative";
popup.prepend(closeIcon);

/* ------------------------- */

popup.querySelector("h3").textContent=t.title;
popup.querySelector("p").textContent=t.text;
document.getElementById("es-wa-btn").textContent=t.whatsapp;

/* ------------------------- */

function showPopup(){
overlay.style.display="flex";
}

function hidePopup(){
overlay.style.display="none";
}

closeIcon.addEventListener("click",hidePopup);

overlay.addEventListener("click",function(e){
if(e.target===overlay){
hidePopup();
}
});

/* -------------------------
   Cart remove popup
------------------------- */

document.addEventListener("click",function(e){

if(!e.target.closest(".close-icon")) return;

setTimeout(async()=>{

try{

const cart=await fetch("/cart.js").then(r=>r.json());

if(cart.item_count>0){
showPopup();
}

}catch(err){
showPopup();
}

},250);

});

/* =====================================================
   ERROR WATCHER
===================================================== */

let errorPopupShown=false;

setInterval(function(){

if(errorPopupShown) return;

document.querySelectorAll(".es-errors").forEach(function(error){

const text=error.textContent.trim();

if(text.length){

errorPopupShown=true;

setTimeout(function(){

showPopup();

},2000);

}

});

},300);

/* -------------------------
   WhatsApp
------------------------- */

document.getElementById("es-wa-btn").addEventListener("click",async()=>{

let message=t.message;

try{

const cart=await fetch("/cart.js").then(r=>r.json());

if(cart.items.length){

cart.items.forEach(function(item){

message+="• "+item.title+"\n";
message+=t.qty+": "+item.quantity+"\n";
message+=t.price+": "+(item.final_price/100).toFixed(2)+" "+Shopify.currency.active+"\n\n";

});

message+=t.total+": "+(cart.total_price/100).toFixed(2)+" "+Shopify.currency.active+"\n\n";

}

}catch(e){}

message+=t.store+":\n"+location.href;

window.open(
"https://wa.me/"+phone+"?text="+encodeURIComponent(message),
"_blank"
);

});

})();
</script>
<!-- 1. مكتبة OpenAI Pixel وتثبيت الـ Pixel ID -->
<script>
  window.oaiq = window.oaiq || function () {
    (window.oaiq.q = window.oaiq.q || []).push(arguments);
  };
  oaiq("init", { pixelId: "NZZ1BhGdRsC8U5TPv95hYx" });
</script>
<script async src="https://bzrcdn.openai.com/sdk/oaiq.min.js"></script>

<!-- 2. ربط الأحداث مع EasySell Form -->
<script>
  // تتبع فتح الفورم
  window.es_hook_open_popup = () => {
    if (typeof oaiq === 'function') {
      oaiq("measure", "lead", {
        type: "form_open"
      });
    }
  };

  // تتبع إتمام الطلب (Purchase / Order Created)
  window.es_hook_purchase_success_func = (order) => {
    if (order && typeof oaiq === 'function') {
      // تحويل المبلغ لعدد صحيح أو رقم عشري مضبوط
      const orderAmount = parseFloat(order.total_price || 0);
      
      oaiq("measure", "order_created", {
        type: "contents",
        amount: orderAmount,
        currency: order.currency || "EGP"
      }, {
        event_id: "order_" + (order.id || Date.now())
      });
    }
  };
</script>
{%- render 'fzl-bf-badge' -%}
  </body>
</html>

{% else %}
{{ content_for_layout }}
{%- endunless -%}