<script>
(function(){
  var root=document.querySelector('.fzl'); if(!root||root.dataset.ready) return; root.dataset.ready=1;
  // نقل الـ sticky والـ lightbox للـ body عشان position:fixed ميتأثرش بأي transform في الثيم
  root.querySelectorAll('.fzl-fixed').forEach(function(el){document.body.appendChild(el);});
  var lb=document.querySelector('.fzl-lb'), box=lb.querySelector('.fzl-lb-in');
  var C='https://cdn.shopify.com/s/files/1/0989/0676/7726/files/';function T(f,t){return '<div class="fzl-lbp"><img src="'+C+f+'" alt="صفحة من فصل '+t+'"><p>دي نص صفحة من فصل «'+t+'» · باقي الصفحة و395 موقف تاني جوه الكتاب</p><button type="button" class="fzl-lb-cta">اطلب الكتاب واقراه كامل</button></div>';}var SRC={'ch-taaruf':T('6k-taaruf.jpg','التعارف'),'ch-matam':T('6k-matam.jpg','المطعم'),'ch-tasawoq':T('6k-tasawoq.jpg','التسوق'),'ch-eatezar':T('6k-eatezar.jpg','الاعتذار'),'ch-mokalmat':T('6k-mokalmat.jpg','المكالمات'),'ch-mashaer':T('6k-mashaer.jpg','المشاعر'),'ch-bayt':T('6k-bayt.jpg','البيت والأطفال'),'ch-mostashfa':T('6k-mostashfa.jpg','المستشفى'),gallery:'<div class="fzl-gal"><img src="'+C+'IMG_0400_2048x2048_bcd069e0-02a4-4124-b9a6-287b80b83c57.jpg?width=700" alt="الكتاب في الإيد"><img src="'+C+'IMG_0388_2048x2048_d3edbfd1-0ade-4c17-96ee-7806a971c5ca.jpg?width=700" alt="الكتاب مفتوح"><img src="'+C+'6k-cover.jpg" alt="الغلاف"><img src="'+C+'6k-index.jpg" alt="الفهرس"><img src="'+C+'6k-taaruf.jpg" alt="صفحة من جوه"><button type="button" class="fzl-lb-cta">اطلب الكتاب</button></div>',
    page:'<img src="https://easyorders.fra1.digitaloceanspaces.com/1708805111166660534.webp" alt="صفحة من الكتاب">',
    index:'<img src="https://easyorders.fra1.digitaloceanspaces.com/1760652709523531051.gif" alt="فهرس الكتاب كامل">',
    audio:'<iframe src="https://www.youtube.com/embed/RsXKofCdMV0?autoplay=1" title="مثال على الصوتيات" allow="autoplay; encrypted-media" allowfullscreen></iframe>'
  };
  function open(k){box.innerHTML=SRC[k];lb.classList.add('on');document.documentElement.style.overflow='hidden';}
  function close(){lb.classList.remove('on');box.innerHTML='';document.documentElement.style.overflow='';}
  root.addEventListener('click',function(e){var b=e.target.closest('[data-lb]');if(b){e.preventDefault();open(b.getAttribute('data-lb'));} });
  lb.addEventListener('click',function(e){var a=e.target.closest('.fzl-lb-cta');if(a){e.preventDefault();close();var s=document.getElementById('es-sticky');if(s){s.click();return;}var o=document.getElementById('fzl-order');if(o)o.scrollIntoView({behavior:'smooth'});return;}if(e.target===lb||e.target.tagName==='BUTTON')close();},true);lb.addEventListener('contextmenu',function(e){e.preventDefault();});
  document.addEventListener('keydown',function(e){if(e.key==='Escape')close();});
  document.querySelectorAll('a[href="#fzl-order"]').forEach(function(a){a.addEventListener('click',function(e){e.preventDefault();document.getElementById('fzl-order').scrollIntoView({behavior:'smooth'});});});
})();
</script>
